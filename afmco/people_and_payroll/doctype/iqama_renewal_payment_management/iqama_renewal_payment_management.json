   "options": "<div class=\"container\">\n    <h1 class=\"text-center mb-4\">قائمة متابعة تجديد الإقامات</h1>\n\n    <div class=\"row\">\n        <!-- كروت الحالة -->\n        <div class=\"col-md-4 mb-4\">\n            <div class=\"card shadow-sm\">\n                <div class=\"card-body\">\n                    <h5 class=\"card-title\">تفصيل الحالات</h5>\n                    <div class=\"stat-item\" id=\"status-new\">New: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-waiting-sadad\">Waiting Sadad: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-awaiting-payment\">Awaiting Payment: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-awaiting-renewal\">Awaiting Renewal: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-issue-preventing-renewal\">Issue Preventing Renewal: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-renewed\">Renewed: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"status-rejected\">Rejected: <span class=\"stat-value\">0</span></div>\n                </div>\n            </div>\n        </div>\n\n        <!-- كروت أعلى 10 إدارات -->\n        <div class=\"col-md-4 mb-4\">\n            <div class=\"card shadow-sm\">\n                <div class=\"card-body\">\n                    <h5 class=\"card-title\">أعلى 10 إدارات</h5>\n                    <div id=\"top-departments\"></div>\n                </div>\n            </div>\n        </div>\n\n        <!-- كروت تحليل انتهاء الإقامة -->\n        <div class=\"col-md-4 mb-4\">\n            <div class=\"card shadow-sm\">\n                <div class=\"card-body\">\n                    <h5 class=\"card-title\">تحليل انتهاء الإقامة</h5>\n                    <div class=\"stat-item\" id=\"expired\">Expired: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"expiring-this-week\">Expiring This Week: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"expiring-next-week\">Expiring Next Week: <span class=\"stat-value\">0</span></div>\n                    <div class=\"stat-item\" id=\"expiring-this-month\">Expiring This Month: <span class=\"stat-value\">0</span></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>",
