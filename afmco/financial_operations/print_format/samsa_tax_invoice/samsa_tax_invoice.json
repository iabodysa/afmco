 "html": "{% import \"afmco/templates/print/identity.html\" as afm %}{{ afm.styles() }}{{ afm.strip() }}\n\r\n<div style='margin-top:5px;font-family: Tahoma, Arial, sans-serif;font-size:11px'>\r\n    <span style='font-size:12px'>\r\n        <table style=\"width:100%\">\r\n            <tr>\r\n                <th width=\"5%\" style='background-color:#072B1A !important;color:white;'>{{ _(\"Tax Invoice\") }}</th>\r\n                <th class=\"text-right\" width=\"45%\" style='background-color:#072B1A!important;color:white;'>{{ _(\"Tax Invoice\", \"ar\", \"Samsa Tax Invoice\") }}</th>\r\n            </tr>\r\n        </table>\r\n        <br>\r\n        <img align=\"left\" style=\"width:15%\" class=\"qr-code\" src=\"{{ doc.ksa_einv_qr }}\">\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:80%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n            <tr>\r\n                <td class=\"text-left\" style=\"padding:0px !important\" width=\"10%\"><b>{{ 'Invoice No.' }}</b></td>\r\n                <td class=\"text-center\" style=\"padding:0px !important\" width=\"25%\">{{ doc.name }}</td>\r\n                <td class=\"text-right\" style=\"padding:0px !important\" width=\"10%\"><b>{{ _(\"Invoice Number\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:80%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n            <tr>\r\n                <td class=\"text-left\" style=\"padding:0px !important\" width=\"10%\"><b>{{ 'Issue Date' }}</b></td>\r\n                <td class=\"text-center\" style=\"padding:1px !important\" width=\"25%\">{{ doc.posting_date }}</td>\r\n                <td class=\"text-right\" style=\"padding:0px !important\" width=\"10%\"><b>{{ _(\"Issue Date\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:80%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n            <tr>\r\n                <td class=\"text-left\" style=\"padding:0px !important\" width=\"10%\"><b>{{ 'Supply on' }}</b></td>\r\n                <td class=\"text-center\" style=\"padding:1px !important\" width=\"25%\">{{ doc.posting_date }}</td>\r\n                <td class=\"text-right\" style=\"padding:0px !important\" width=\"10%\"><b>{{ _(\"Supply Date\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:80%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n            <tr>\r\n                <td class=\"text-left\" style=\"padding:0px !important\" width=\"10%\"><b>{{ 'P.O No.' }}</b></td>\r\n                <td class=\"text-center\" style=\"padding:1px !important\" width=\"25%\">{{ doc.po_no }}</td>\r\n                <td class=\"text-right\" style=\"padding:0px !important\" width=\"10%\"><b>{{ _(\"Purchase Order Number\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            </tr>\r\n        </table>\r\n\r\n        <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:80%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n            <tr>\r\n                <td class=\"text-left\" style=\"padding:0px !important\" width=\"10%\"><b>{{ 'P.O Date' }}</b></td>\r\n                <td class=\"text-center\" style=\"padding:1px !important\" width=\"25%\">{{ doc.po_date }}</td>\r\n                <td class=\"text-right\" style=\"padding:0px !important\" width=\"10%\"><b>{{ _(\"Purchase Order Date\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </span>\r\n    <br>\r\n\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n        <tr>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Seller ' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\"></td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Supplier\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Client' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\"></td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Buyer\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n        <tr>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Name ' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\"><b>{{ _(\"Ersaa Al Jazeera Business Solutions Company\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Name\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Name' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\"><b>{{ doc.customer_name }}</b></td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Name\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n        <tr>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Address ' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">{{ doc.company_address_display }}</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Address\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Address' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">{{ doc.address_display }}</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Address\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n        <tr>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'VAT Number ' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">{{ doc.company_tax_id }}</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"VAT Registration Number\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'VAT Number' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">{{ doc.tax_id }}</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"VAT Registration Number\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n        <tr>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Seller CR:' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">1010232911</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Commercial Registration\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n            <td class=\"text-left\" style=\"padding:3px !important\" width=\"10%\"><b>{{ 'Client CR:' }}</b></td>\r\n            <td class=\"text-center\" style=\"padding:3px !important\" width=\"30%\">{{ doc.client_ccr_no }}</td>\r\n            <td class=\"text-right\" style=\"padding:3px !important\" width=\"10%\"><b>{{ _(\"Commercial Registration\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        </tr>\r\n    </table>\r\n</div>\r\n<br>\r\n<table class=\"table table-bordered\" style=\"border: 1px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n    <tbody>\r\n        <tr>\r\n            <td style='padding:0px !important' colspan=2>\r\n                <table class=\"table table-bordered\" style=\"border: 0px solid #dddddd; width:100%; collapse;font-family: Tahoma, Arial, sans-serif;margin:0px;font-size:10px\">\r\n                    <thead>\r\n                        <tr>\r\n                            <td width=\"34%\" class=\"text-center\"><b>Product {{ _(\"Products\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"3%\" class=\" text-center\"><b>Qty {{ _(\"Quantity\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"10%\" class=\"text-center\"><b>Rate <br> {{ _(\"Rate\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"12%\" class=\"text-center\"><b>Value <br> {{ _(\"Value\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"6%\" class=\"text-center\"><b>Discount <br> {{ _(\"Discount\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"12%\" class=\"text-center\"><b>Taxable Amount <br> {{ _(\"Taxable Amount\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"3%\" class=\" text-center\"><b>Tax% <br> {{ _(\"Tax Rate\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"6%\" class=\"text-center\"><b>Tax Amount <br> {{ _(\"Tax Amount\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                            <td width=\"35%\" class=\"text-center\"><b>Total inclusive of VAT <br> {{ _(\"Total inclusive of VAT\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n                        </tr>\r\n                    </thead>\r\n                    <tbody>\r\n                        {%- for item in doc.items -%}\r\n                        <tr>\r\n                            <td class=\"text-center\">{{ item.get_formatted(\"description\") }}</td>\r\n                            <td>\r\n                                <div style=\"display: flex; justify-content: space-between;\">\r\n                                    <span>{{ item.qty }}</span>\r\n                                </div>\r\n                            </td>\r\n                          <td class=\"text-right\">{{ item.get_formatted(\"rate\") }}</td>\r\n                          <td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\r\n                          <td class=\"text-right\">{{ doc.get_formatted(\"discount_amount\") }}</td>\r\n                          <td class=\"text-right\">{{ doc.get_formatted(\"net_total\") }}</td>\r\n                          <!--<td class=\"text-right\">{{ item.tax_rate }}</td>-->\r\n                          <td class=\"text-right\">{{ 15 }}</td>\r\n                        \r\n                          <td class=\"text-right\">{{ item.get_formatted(\"tax_amount\") }}</td>\r\n                          <td class=\"text-right\">{{ item.get_formatted(\"total_amount\") }}</td>\r\n                        </tr>\r\n                        {%- endfor -%}\r\n                    </tbody>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </tbody>\r\n    <tr>\r\n        <td class=\"text-left\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \" Total Amount \" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total Amounts\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n    </tr>\r\n</table>\r\n<table class=\"table table-bordered\" style=\"border: 0px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n    <tr>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \" Total ( Excluding VAT ) \" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total (Excluding VAT)\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\">{{ doc.get_formatted(\"total\") }}</td>\r\n    </tr>\r\n</table>\r\n<table class=\"table table-bordered\" style=\"border: 0px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n    <tr>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \"Discount \" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total Discounts\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\">{{ doc.get_formatted(\"discount_amount\") }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \"Total Taxable Amount ( Excluding VAT) \" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total Taxable Amount (Excluding VAT)\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\">{{ doc.get_formatted(\"net_total\") }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \"Total VAT\" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total VAT\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\">{{ doc.get_formatted(\"total_taxes_and_charges\") }}</td>\r\n    </tr>\r\n    <tr>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ \"Total Amount Due\" }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\"><b>{{ _(\"Total Amount Due\", \"ar\", \"Samsa Tax Invoice\") }}</b></td>\r\n        <td class=\"text-right\" style=\"padding:3px !important\" width=\"40%\">{{ doc.get_formatted(\"grand_total\") }}</td>\r\n    </tr>\r\n</table>\r\n<table class=\"table table-bordered\" style=\"border: 0px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n    <tr>\r\n        <td class=\"text-center\" style=\"padding:10px !important\">{{ doc.get_formatted(\"in_words\") }}</td>\r\n    </tr>\r\n</table>\r\n<table class=\"table table-bordered\" style=\"border: 0px solid #dddddd; width:100%; border-collapse: collapse;font-family: Tahoma, Arial, sans-serif;margin:0px\">\r\n    <tr>\r\n        <td class=\"text-center\" style=\"padding:10px !important\"> </td>\r\n    </tr>\r\n</table>\r\n\r\n\r\n",
