 "html": "{% import \"afmco/templates/print/identity.html\" as afm %}{{ afm.styles() }}<style>\n.print-format small, .print-format p, .print-format td, .print-format div, .print-format h4 { font-family: \"Noto Sans Arabic\", \"Noto Sans\", \"DejaVu Sans\", sans-serif; color: #171717; }\n.print-format .afm-title-en { font-family: \"Noto Sans\", \"DejaVu Sans\", sans-serif; color: #171717; }\n.print-format .afm-title-ar { color: #00844e; }\n.print-format .afm-box { border-color: #00844e; }\n.print-format .afm-box .table-bordered, .print-format .afm-box .table-bordered td { border-color: #d0d0d0 !important; }\n.print-format .afm-box .table-bordered td + td { background-color: #f4f4f4; color: #5f5f5f; -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n.print-format .afm-num { direction: ltr; unicode-bidi: embed; font-family: \"Noto Sans\", \"DejaVu Sans\", sans-serif; white-space: nowrap; }\n.print-format td.afm-num { text-align: right; }\n.print-format .afm-ids { width: 100%; margin: -6px 0 8px 0; border-collapse: collapse; }\n.print-format .afm-ids td { font-size: 8pt; line-height: 12px; color: #5f5f5f; text-align: center; padding: 0 4px; white-space: nowrap; }\n.print-format .afm-ids b { color: #171717; }\n</style>{%- macro add_header(page_num, max_pages, doc, letter_head, no_letterhead) -%}\n    {% if letter_head and not no_letterhead %}\n    <div class=\"letter-head\">{{ letter_head }}</div>\n    {% endif %}\n    {%- if doc.meta.is_submittable and doc.docstatus==2-%}\n    <div class=\"alert alert-danger text-center\">\n        <h4 style=\"margin: 0px;\">{{ _(\"CANCELLED\") }}</h4></div>\n    {%- endif -%}\n    {% if max_pages > 1 %}\n    <p class=\"text-right\">{{ _(\"Page #{0} of {1}\").format(page_num, max_pages) }}</p>\n    {% endif %}\n{%- endmacro -%}\n<small>\n{{ add_header(0,1,doc,letter_head, no_letterhead) }}\n{{ afm.strip() }}{%- set _v_vat = (frappe.db.get_value('Company', doc.company, 'tax_id') if doc.company else '') or '' -%}\n{%- set _v_zbs = frappe.db.get_value('ZATCA Business Settings', {'company': doc.company}, 'name') if doc.company else none -%}\n{%- set _v_ns = namespace(cr='') -%}\n{%- if _v_zbs -%}{%- for r in frappe.get_doc('ZATCA Business Settings', _v_zbs).other_ids -%}{%- if r.type_code == 'CRN' and r.value and not _v_ns.cr -%}{%- set _v_ns.cr = r.value -%}{%- endif -%}{%- endfor -%}{%- endif -%}\n{%- set _v_kv = _('Tax Id', 'ar') -%}{%- set _v_kc = _('Commercial Registration Number', 'ar') -%}\n{%- if _v_vat or _v_ns.cr %}\n<table class=\"afm-ids\"><tr>\n{%- if _v_vat %}<td><span class=\"afm-num\">VAT No.</span>&nbsp; <b class=\"afm-num\">{{ _v_vat }}</b>{% if _v_kv != 'Tax Id' %}&nbsp; <span dir=\"rtl\">{{ _v_kv }}</span>{% endif %}</td>{% endif %}\n{%- if _v_ns.cr %}<td><span class=\"afm-num\">CR No.</span>&nbsp; <b class=\"afm-num\">{{ _v_ns.cr }}</b>{% if _v_kc != 'Commercial Registration Number' %}&nbsp; <span dir=\"rtl\">{{ _v_kc }}</span>{% endif %}</td>{% endif %}\n</tr></table>\n{%- endif %}\n<div class=\"row\">\n    <div class=\"col-xs-6\">\n        <p class=\"afm-title-en\">Cash Receive Voucher</p>\n    </div>\n    <div class=\"col-xs-6\">\n        <p class=\"afm-title-ar\">{{ _(\"Cash Receipt Voucher\", \"ar\", \"Cash Receipt Voucher\") }} </p>\n    </div>\n</div>    \n<div class=\"afm-box\" style=\"padding:10px 8px;\">\n    <div class=\"row\">\n        <div class=\"col-xs-4\">\n            <table class=\"table table-bordered\" style=\"margin: 0;\">\n                <tr>\n                    <td class=\"afm-num\">{{doc.name}}</td>\n                    <td>NO</td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"col-xs-4\">\n        </div>    \n        <div class=\"col-xs-4\">\n            <table class=\"table table-bordered\" style=\"margin: 0;\">\n                <tr>\n                    <td class=\"afm-num\">{{doc.name}}</td>\n                    <td>{{ _(\"No.\", \"ar\", \"Cash Receipt Voucher\") }}</td>\n                </tr>\n            </table>\n        </div>\n    </div>\n    <div style=\"width: 100%; height: 20px; display: block;\"></div>\n    <div class=\"row\">\n        <div class=\"col-xs-2\">\n            <p style=\"text-align: right;  padding:0; \">Name:</p>\n        </div>\n        <div class=\"col-xs-8\">\n            <p style=\" padding:0;  border-bottom: 1px dashed #d0d0d0 ;\">{{doc.pay_to_recd_from}}</p>\n        </div>    \n        <div class=\"col-xs-2\">\n            <p style=\" padding:0; \">{{ _(\"Name:\", \"ar\", \"Cash Receipt Voucher\") }}</p>\n        </div>\n    </div>        \n    <div class=\"row\">\n        <div class=\"col-xs-2\">\n            <p style=\"text-align: right;  padding:0; \">Amount:</p>\n        </div>\n        <div class=\"col-xs-8\">\n            <p style=\" padding:0;  border-bottom: 1px dashed #d0d0d0 ;\"><span class=\"afm-num\">{{doc.total_debit}}</span></p>\n        </div>    \n        <div class=\"col-xs-2\">\n            <p style=\"f padding:0; \">{{ _(\"Amount:\", \"ar\", \"Cash Receipt Voucher\") }}</p>\n        </div>\n    </div>    \n    <div class=\"row\">\n        <div class=\"col-xs-2\">\n            <p style=\"text-align: right;  padding:0; \">Remark :</p>\n        </div>\n        <div class=\"col-xs-8\">\n            <p style=\" padding:0;  border-bottom: 1px dashed #d0d0d0 ;\">{{doc.remark}}</p>\n        </div>    \n        <div class=\"col-xs-2\">\n            <p style=\" padding:0; \">{{ _(\"Being for\", \"ar\", \"Cash Receipt Voucher\") }}</p>\n        </div>\n    </div>\n    <div style=\"width: 100%; height: 15px; display: block;\"></div>        \n    <div class=\"row\">\n        <div class=\"col-xs-1\">\n            \n        </div>\n        <div class=\"col-xs-3\">\n            <p style=\"text-align: right;  padding:0; margin: 0;\">Date : {{doc.get_formatted(\"posting_date\")}}</p>\n        </div>  \n        <div class=\"col-xs-4\"></div>  \n        <div class=\"col-xs-3\">\n            <p style=\" padding:0; margin: 0;\">{{ _(\"Date:\", \"ar\", \"Cash Receipt Voucher\") }} {{doc.posting_date}}</p>\n        </div>\n    </div>\n    <div style=\"width: 100%; height: 15px; display: block;\"></div>     \n    <div class=\"row\">\n        <div class=\"col-xs-1\">\n            \n        </div>\n        <div class=\"col-xs-5\">\n            <p style=\"padding:0;  text-align:center;\">General Manager :{{ _(\"General Manager\", \"ar\", \"Cash Receipt Voucher\") }} </p>\n            <p style=\"border-bottom: 1px dashed #d0d0d0 ;  padding:0; min-height: 15px;\"></p>\n        </div>  \n        <div class=\"col-xs-5\">\n            <p style=\"padding:0;  text-align:center;\">Finance Manager :{{ _(\"Finance Manager\", \"ar\", \"Cash Receipt Voucher\") }} </p>\n            <p style=\" padding:0;  border-bottom: 1px dashed #d0d0d0 ; min-height: 15px;\"> </p>\n        </div>\n    </div>  \n    <div style=\"width: 100%; height: 15px; display: block;\"></div>     \n    <div class=\"row\">\n        <div class=\"col-xs-4\"></div>\n        <div class=\"col-xs-4\">\n            <p style=\"padding:0; text-align:center;\">Received By : {{ _(\"Received By\", \"ar\", \"Cash Receipt Voucher\") }} </p>\n            <p style=\"border-bottom: 1px dashed #d0d0d0 ;  padding:0; min-height: 15px;\"></p>\n        </div>  \n    </div>   \n</div>",
